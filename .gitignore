# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Generated build outputs
Build/**/FileOpenOrder/
Build/**/FileOpenOrder*.log
Build/**/FileOpenOrder*.txt
Build/**/Paks/
Build/**/Staged/

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Unreal Engine generated plugin caches
Plugins/**/DerivedDataCache/
Plugins/**/Saved/

# Visual Studio temporary files
*.VC.db-shm
*.VC.db-wal
*.VC.db-journal
*.VC.db-lock
*.ipch
*.tlog
*.lastbuildstate
*.log

# Windows temporary files
Desktop.ini
*.tmp
*.temp
*.bak

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Claude Code local data
.claude/settings.local.json

# Local AI agent scratch files
.claude/worktrees/

# GitHub Desktop / Git merge leftovers
*.orig
*.rej